# bash completion for hulak
# Generated code. Do not edit by hand.

_hulak_path_files() {
  local cur=$1 f
  COMPREPLY=()
  while IFS= read -r f; do [[ -n $f ]] && COMPREPLY+=("$f"); done < <(compgen -f -- "$cur")
  compopt -o filenames 2>/dev/null
}

_hulak_envs() {
  [[ -d env ]] || return 0
  local f
  for f in env/*.env; do [[ -e $f ]] || continue; f=${f##*/}; printf '%s\n' "${f%.env}"; done
}

_hulak_yaml_files() {
  local cur=$1 f
  COMPREPLY=()
  while IFS= read -r f; do
    case "$f" in *.yaml|*.yml|*.hk.yaml|*.hk.yml) COMPREPLY+=("$f") ;; esac
  done < <(compgen -f -- "$cur")
  while IFS= read -r f; do [[ -n $f ]] && COMPREPLY+=("$f"); done < <(compgen -d -- "$cur")
  compopt -o filenames 2>/dev/null
}

_hulak_takes_value() {
  case "$1" in
    --env|--environment|--file-path|--fp|--out|--timeout|-env|-environment|-file-path|-fp|-o|-out|-timeout) return 0 ;;
  esac
  return 1
}

_hulak_complete_value() {
  case "$1" in
    --env|--environment|-env|-environment) COMPREPLY=( $(compgen -W "$(_hulak_envs)" -- "$2") ) ;;
    --file-path|--fp|--out|-file-path|-fp|-o|-out) _hulak_path_files "$2" ;;
    *) COMPREPLY=() ;;
  esac
}

_hulak_is_path() {
  case "$1" in
    hulak|hulak:completion|hulak:completion:bash|hulak:completion:zsh|hulak:env|hulak:env:keys|hulak:env:keys:get|hulak:env:keys:set|hulak:env:list|hulak:import|hulak:init|hulak:init:classic|hulak:init:no-vault|hulak:init:plain|hulak:run|hulak:secrets|hulak:secrets:keys|hulak:secrets:keys:get|hulak:secrets:keys:set|hulak:secrets:list|hulak:version) return 0 ;;
  esac
  return 1
}

_hulak_after_dashes() {
  case "$1" in
    hulak:run) _hulak_yaml_files "$2" ;;
    hulak:import) _hulak_path_files "$2" ;;
    *) COMPREPLY=() ;;
  esac
}

_hulak() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" chain=hulak i=1 dashes=0
  while (( i < COMP_CWORD )); do
    local w="${COMP_WORDS[i]}"
    if [[ -z $w ]]; then ((i++)); continue; fi
    if [[ $w == -- ]]; then dashes=1; break; fi
    if [[ $w == -?* ]]; then
      _hulak_takes_value "$w" && ((i++))
      ((i++)); continue
    fi
    if _hulak_is_path "$chain:$w"; then chain+=:$w; ((i++)); else break; fi
  done
  if (( dashes )); then _hulak_after_dashes "$chain" "$cur"; return; fi
  if _hulak_takes_value "$prev"; then _hulak_complete_value "$prev" "$cur"; return; fi
  case "$chain" in
    hulak)
      COMPREPLY=( $(compgen -W "--debug --env --environment --file-path --fp --help completion env import init run secrets version" -- "$cur") )
      ;;
    hulak:run)
      if [[ $cur == -* ]]; then COMPREPLY=( $(compgen -W "--env --environment --out --timeout -o" -- "$cur") )
      else _hulak_yaml_files "$cur"; fi
      ;;
    hulak:secrets|hulak:env)
      COMPREPLY=( $(compgen -W "keys list" -- "$cur") )
      ;;
    hulak:secrets:keys|hulak:env:keys)
      COMPREPLY=( $(compgen -W "get set" -- "$cur") )
      ;;
    hulak:secrets:keys:set|hulak:env:keys:set)
      COMPREPLY=( $(compgen -W "--env" -- "$cur") )
      ;;
    hulak:init)
      COMPREPLY=( $(compgen -W "--env classic no-vault plain" -- "$cur") )
      ;;
    hulak:init:classic|hulak:init:plain|hulak:init:no-vault)
      COMPREPLY=( $(compgen -W "--force" -- "$cur") )
      ;;
    hulak:completion)
      COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
      ;;
    hulak:import)
      _hulak_path_files "$cur"
      ;;
    *) COMPREPLY=() ;;
  esac
}

complete -F _hulak hulak

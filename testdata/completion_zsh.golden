# Generated by 'hulak gendocs' — do not edit by hand.

_hulak() {
  local state ret=1
  _arguments -C \
    '--debug[Print full request and response details]' \
    '(--env --environment)'{--env,--environment}'[Environment file to use]:env:_hulak_envs' \
    '(--file-path --fp)'{--file-path,--fp}'[Exact path of the request file]:path:_files' \
    '1: :_hulak_subs' \
    '*::arg:->args' && ret=0
  [[ $state == args ]] && case $words[1] in
    run) _hulak_run && ret=0 ;;
    secrets|env) _hulak_secrets && ret=0 ;;
    init) _hulak_init && ret=0 ;;
    completion) _hulak_completion && ret=0 ;;
    import) _hulak_import && ret=0 ;;
  esac
  return ret
}

_hulak_subs() {
  local -a subs=(
    'run:Run API request files'
    'secrets:Manage encrypted environment secrets'
    'env:Manage encrypted environment secrets'
    'init:Initialize a project'
    'completion:Print a shell completion script'
    'import:Import a file'
    'version:Print the version'
  )
  _describe -t commands 'hulak subcommand' subs
}

_hulak_run() {
  _arguments \
    '(--env --environment)'{--env,--environment}'[Environment file to use]:env:_hulak_envs' \
    '(--out -o)'{--out,-o}'[Write responses to this path]:path:_files' \
    '--timeout[Seconds before a request is cancelled]:value:' \
    '*:file or directory:_files -g "*.(yaml|yml|hk.yaml|hk.yml)"'
}

